<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Painel administrativo | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <%- include("../partials/header") %>

    <main class="painel-admin">
        <div class="container">

            <div class="admin-cabecalho">
                <span class="admin-etiqueta">ECOTECH</span>
                <h1>Painel administrativo</h1>
                <p>Analise os eletrônicos enviados pelos usuários antes da publicação.</p>
            </div>

            <% if (mensagem) { %>
                <div class="alert alert-info">
                    <%= mensagem %>
                </div>
            <% } %>

            <div class="admin-resumo">
                <span>Produtos aguardando aprovação</span>
                <strong><%= produtos.length %></strong>
            </div>

            <% if (produtos.length === 0) { %>

                <div class="admin-vazio">
                    <h2>Nenhum produto pendente</h2>
                    <p>Quando um usuário cadastrar um eletrônico, ele aparecerá aqui.</p>
                </div>

            <% } else { %>

                <div class="admin-lista">

                    <% produtos.forEach(produto => { %>

                        <article class="admin-produto">

                            <% if (produto.fotoUrl) { %>
                                <img
                                    src="<%= produto.fotoUrl %>"
                                    alt="Foto de <%= produto.nome %>"
                                    class="admin-produto-foto"
                                >
                            <% } else { %>
                                <div class="admin-sem-foto">
                                    Sem foto
                                </div>
                            <% } %>

                            <div class="admin-produto-info">

                                <h2><%= produto.nome %></h2>

                                <p><strong>Categoria:</strong> <%= produto.categoria %></p>
                                <p><strong>Funcionamento:</strong> <%= produto.funcionamento %></p>
                                <p><strong>Descrição:</strong> <%= produto.descricao %></p>

                                <% if (produto.problema) { %>
                                    <p><strong>Problemas:</strong> <%= produto.problema %></p>
                                <% } %>

                                <p>
                                    <strong>Preço:</strong>
                                    <%= produto.preco !== null && produto.preco !== undefined
                                        ? produto.preco.toLocaleString("pt-BR", { style: "currency", currency: "BRL" })
                                        : "Não informado" %>
                                </p>

                                <div class="admin-usuario">
                                    <strong>Enviado por:</strong>
                                    <%= produto.nomeUsuario %>
                                    <% if (produto.emailUsuario) { %>
                                        <span><%= produto.emailUsuario %></span>
                                    <% } %>
                                </div>

                                <div class="admin-acoes">

                                    <form
                                        action="/admin/aprovar/<%= produto.id %>"
                                        method="POST"
                                        onsubmit="return confirm('Deseja aprovar este produto?')"
                                    >
                                        <button type="submit" class="btn-aprovar">
                                            Aprovar produto
                                        </button>
                                    </form>

                                    <form
                                        action="/admin/rejeitar/<%= produto.id %>"
                                        method="POST"
                                        onsubmit="return confirm('Deseja rejeitar este produto?')"
                                    >
                                        <button type="submit" class="btn-rejeitar">
                                            Rejeitar produto
                                        </button>
                                    </form>

                                </div>

                            </div>
                        </article>

                    <% }) %>

                </div>

            <% } %>

        </div>
    </main>

    <%- include("../partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>