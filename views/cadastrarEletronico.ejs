
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar eletrônico | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/cadastrarEletronico.css">
</head>
<body>

    <%- include("partials/header") %>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <h1>Cadastrar eletrônico</h1>
                <p>Preencha as informações do aparelho que deseja anunciar.</p>

                <% if (erro) { %>
                    <div class="alert alert-danger"><%= erro %></div>
                <% } %>

                <% if (sucesso) { %>
                    <div class="alert alert-success">
                        Eletrônico cadastrado! Aguarde a aprovação da equipe EcoTech.
                    </div>
                <% } %>

                <form action="/cadastrar-eletronico" method="POST" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label for="categoria" class="form-label">Tipo de eletrônico</label>
                        <select class="form-select" id="categoria" name="categoria" required>
                            <option value="">Selecione</option>
                            <option value="celular">Celular</option>
                            <option value="computador">Computador / Notebook</option>
                            <option value="tablet">Tablet</option>
                            <option value="televisao">Televisão</option>
                            <option value="perifericos">Periféricos</option>
                            <option value="console">Console</option>
                            <option value="impressora">Impressora</option>
                            <option value="outros">Outros</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="marca" class="form-label">Marca</label>
                        <select class="form-select" id="marca" name="marca" required disabled>
                            <option value="">Selecione primeiro o tipo</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="modelo" class="form-label">Modelo</label>

                        <select class="form-select" id="modelo" name="modelo" required disabled>
                            <option value="">Selecione primeiro a marca</option>
                        </select>

                        <input
                            type="text"
                            class="form-control"
                            id="modeloManual"
                            maxlength="100"
                            placeholder="Digite o modelo"
                            hidden
                            disabled
                        >

                        <small id="avisoCatalogo" class="form-text text-muted"></small>
                    </div>

                    <div id="especificacoes" hidden>
                        <h5>Especificações do aparelho</h5>

                        <div class="mb-3" id="campoRam" hidden>
                            <label for="ram" class="form-label">Memória RAM</label>
                            <input type="text" class="form-control" id="ram" name="ram" placeholder="Ex.: 8 GB">
                        </div>

                        <div class="mb-3" id="campoArmazenamento" hidden>
                            <label for="armazenamento" class="form-label">Armazenamento</label>
                            <input type="text" class="form-control" id="armazenamento" name="armazenamento" placeholder="Ex.: 256 GB">
                        </div>

                        <div class="mb-3" id="campoTela" hidden>
                            <label for="tamanhoTela" class="form-label">Tamanho da tela</label>
                            <input type="text" class="form-control" id="tamanhoTela" name="tamanhoTela" placeholder="Ex.: 6,7 polegadas">
                        </div>

                        <div class="mb-3" id="campoProcessador" hidden>
                            <label for="processador" class="form-label">Processador</label>
                            <input type="text" class="form-control" id="processador" name="processador" placeholder="Ex.: Intel Core i5">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="funcionamento" class="form-label">Estado de funcionamento</label>
                        <select class="form-select" id="funcionamento" name="funcionamento" required>
                            <option value="">Selecione</option>
                            <option value="funcionando">Funcionando normalmente</option>
                            <option value="parcial">Funcionando parcialmente</option>
                            <option value="defeito">Com defeito</option>
                            <option value="nao_liga">Não liga</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="descricao" class="form-label">Descrição</label>
                        <textarea class="form-control" id="descricao" name="descricao" maxlength="500" rows="4" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="problema" class="form-label">Problemas ou defeitos</label>
                        <textarea class="form-control" id="problema" name="problema" maxlength="300" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="preco" class="form-label">Preço desejado (opcional)</label>
                        <input type="number" class="form-control" id="preco" name="preco" min="0" step="0.01">
                    </div>

                    <div class="mb-3">
                        <label for="foto" class="form-label">Foto do eletrônico</label>
                        <input type="file" class="form-control" id="foto" name="foto" accept="image/jpeg,image/png,image/webp">
                        <small class="form-text text-muted">JPG, PNG ou WEBP. Máximo de 5 MB.</small>
                    </div>

                    <button type="submit" class="btn btn-primary">Cadastrar eletrônico</button>
                </form>
            </div>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cadastrarEletronico.js"></script>
</body>
</html>
