
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" href="../img/logo_da_aba_de_pesquisa.png" type="image/png">

    <title>EcoPontos | EcoTech</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Leaflet -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/ecopontos.css">

</head>

<body>

    <%- include("partials/header") %>

    <main class="ecopontos-page">

        <div class="container">

            <!-- INTRODUÇÃO -->

            <div class="ecopontos-intro">

                <span class="text-success fw-semibold">
                    DESCARTE CONSCIENTE
                </span>

                <h1>
                    Encontre um ponto de coleta perto de você.
                </h1>

                <p class="text-secondary">
                    Localize pontos de reciclagem próximos e descubra onde
                    realizar o descarte adequado de resíduos.
                </p>

                <button class="location-button" id="btnLocalizar" type="button">
    <i class="bi bi-geo-alt"></i>
    <span>Encontrar pontos próximos</span>
</button>

                <p id="statusEcopontos">
                    Clique no botão para utilizar sua localização.
                </p>

            </div>

            <!-- MAPA E PAINEL -->

            <div class="row g-4">

                <!-- MAPA -->

                <div class="col-lg-8">

                    <div class="map-container">
                        <div id="mapaEcopontos"></div>
                    </div>

                </div>

                <!-- PAINEL LATERAL -->

                <div class="col-lg-4">

                    <div class="ecopontos-panel h-100">

                        <h4 class="mb-1">
                            Pontos próximos
                        </h4>

                        <p class="text-secondary small">
                            Os três pontos mais próximos da sua localização.
                        </p>

                        <div id="listaEcopontos">

                            <p class="text-secondary small">
                                Aguardando localização...
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- AVISO -->

            <p class="text-secondary small mt-4">

                Os pontos são encontrados por meio de dados do OpenStreetMap.
                Consulte o estabelecimento antes de levar seus resíduos:
                nem todos os locais recebem lixo eletrônico.

            </p>

        </div>

    </main>


    <!-- ====================================== -->
    <!-- MODAL DE BUSCA DE ECOPONTOS -->
    <!-- ====================================== -->

    <div
        class="modal fade"
        id="modalEcopontos"
        tabindex="-1"
        aria-labelledby="tituloModalEcopontos"
        aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">

            <div class="modal-content">

                <!-- CABEÇALHO -->

                <div class="modal-header">

                    <h5 class="modal-title" id="tituloModalEcopontos">

                        <i class="bi bi-geo-alt"></i>

                        Ecopontos próximos de você

                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                    </button>

                </div>

                <!-- CORPO -->

                <div class="modal-body">

                    <p
                        id="statusModalEcopontos"
                        class="text-muted text-center">

                        Estamos procurando locais de descarte próximos a você...

                    </p>

                    <div id="listaModalEcopontos">

                        <div class="text-center py-3">

                            <div
                                class="spinner-border text-success"
                                role="status">

                                <span class="visually-hidden">
                                    Carregando...
                                </span>

                            </div>

                            <p class="small text-muted mt-2">
                                Buscando ecopontos...
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ====================================== -->
    <!-- SCRIPTS -->
    <!-- ====================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="/js/ecopontos.js"></script>

</body>

</html>
