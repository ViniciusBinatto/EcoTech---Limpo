
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Minha conta | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/perfil.css">
</head>

<body class="perfil-page">

    <%- include("partials/header") %>

    <main class="dashboard-container">

        <aside class="dashboard-sidebar">

            <div class="sidebar-user">
                <div class="user-avatar">
                    <%= usuario.nome.charAt(0).toUpperCase() %>
                </div>

                <div>
                    <strong><%= usuario.nome %></strong>
                    <span>Minha conta</span>
                </div>
            </div>

            <nav class="dashboard-menu">
                <a href="/perfil" class="active">
                    <span>01</span>
                    Visão geral
                </a>

                <a href="/ecoprodutos">
                    <span>02</span>
                    EcoProdutos
                </a>

                <a href="/ecopontos">
                    <span>03</span>
                    EcoPontos
                </a>
            </nav>

            <form action="/logout" method="POST" class="logout-form">
                <button type="submit">Sair da conta</button>
            </form>

        </aside>

        <section class="dashboard-content">

            <div class="dashboard-heading">
                <div>
                    <span class="dashboard-eyebrow">ÁREA DO USUÁRIO</span>
                    <h1>Olá, <%= usuario.nome.split(" ")[0] %>.</h1>
                    <p>Acompanhe sua participação no movimento EcoTech.</p>
                </div>

                <span class="account-status">Conta ativa</span>
            </div>

            <div class="dashboard-welcome">
                <div>
                    <span>TECNOLOGIA COM PROPÓSITO</span>
                    <h2>Pequenas atitudes criam novos ciclos.</h2>
                    <p>
                        Continue contribuindo para um futuro mais
                        sustentável por meio do consumo consciente.
                    </p>

                    <a href="/ecopontos">Encontrar pontos de coleta</a>
                </div>
            </div>

            <div class="dashboard-section-heading">
                <div>
                    <h2>Minha área</h2>
                    <p>Acesse as principais funcionalidades da plataforma.</p>
                </div>
            </div>

            <div class="dashboard-cards">

                <a href="/ecoprodutos" class="dashboard-card">
                    <span class="card-number">01</span>
                    <h3>EcoProdutos</h3>
                    <p>
                        Explore eletrônicos que podem ganhar
                        uma nova oportunidade de uso.
                    </p>
                    <span class="card-link">Explorar produtos →</span>
                </a>

                <a href="/ecopontos" class="dashboard-card">
                    <span class="card-number">02</span>
                    <h3>EcoPontos</h3>
                    <p>
                        Localize pontos de coleta próximos
                        e descarte corretamente seus eletrônicos.
                    </p>
                    <span class="card-link">Encontrar pontos →</span>
                </a>

               <div class="dashboard-card">
    <span class="card-number">03</span>

    <h3>Meus eletrônicos</h3>

    <p>
        Você possui <strong><%= produtos.length %></strong>
        eletrônico(s) cadastrado(s).
    </p>

    <% if (produtos.length === 0) { %>
        <p class="mensagem-sem-produtos">
            Você ainda não cadastrou nenhum eletrônico.
        </p>
    <% } else { %>

        <div class="lista-meus-eletronicos">
            <% produtos.slice(0, 3).forEach(produto => { %>
                <div class="item-meu-eletronico">
                    <strong><%= produto.nome %></strong>

                    <span class="status-eletronico status-<%= produto.status %>">
                        <% if (produto.status === "pendente") { %>
                            Aguardando aprovação
                        <% } else if (produto.status === "aprovado") { %>
                            Aprovado
                        <% } else if (produto.status === "rejeitado") { %>
                            Rejeitado
                        <% } else { %>
                            <%= produto.status %>
                        <% } %>
                    </span>
                </div>
            <% }) %>
        </div>

        <% if (produtos.length > 3) { %>
            <p class="mais-produtos">
                E mais <%= produtos.length - 3 %> eletrônico(s).
            </p>
        <% } %>

    <% } %>

    <a href="/cadastrar-eletronico" class="card-link">
        Cadastrar eletrônico
    </a>
</div>

            </div>

            <section class="account-information">
                <div class="dashboard-section-heading">
                    <div>
                        <h2>Dados da conta</h2>
                        <p>Informações do seu cadastro.</p>
                    </div>
                </div>

                <div class="account-data">
                    <div>
                        <span>Nome completo</span>
                        <strong><%= usuario.nome %></strong>
                    </div>

                    <div>
                        <span>E-mail</span>
                        <strong><%= usuario.email %></strong>
                    </div>

                    <div>
                        <span>Tipo de conta</span>
                        <strong><%= usuario.tipo === "admin" ? "Administrador" : "Usuário" %></strong>
                    </div>
                </div>
            </section>

        </section>
    </main>

    <%- include("partials/footer") %>

</body>
</html>
