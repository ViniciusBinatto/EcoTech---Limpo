
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar eletrônico | EcoTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/cadastrarEletronico.css">
</head>
<body>

    <%- include("partials/header") %>

    <main class="cadastro-eletronico">
        <div class="container">

            <a href="/perfil" class="voltar-perfil">← Voltar para minha conta</a>

            <div class="formulario-cabecalho">
                <span class="formulario-etiqueta">ECOPRODUTOS</span>
                <h1>Cadastre seu eletrônico</h1>
                <p>Compartilhe um equipamento que pode ganhar um novo ciclo de vida.</p>
            </div>

            <form class="formulario-eletronico"
                  action="/cadastrar-eletronico"
                  method="POST"
                  enctype="multipart/form-data">

                <% if (erro) { %>
                    <div class="alert alert-danger"><%= erro %></div>
                <% } %>

                <% if (sucesso) { %>
                    <div class="alert alert-success">
                        Seu eletrônico foi cadastrado e está aguardando aprovação.
                    </div>
                <% } %>

                <div class="campo-grupo">
                    <label for="categoria">Tipo de eletrônico</label>
                    <select id="categoria" name="categoria" required>
                        <option value="">Selecione uma categoria</option>
                        <option value="celular">Celular</option>
                        <option value="computador">Computador / Notebook</option>
                        <option value="tablet">Tablet</option>
                        <option value="televisao">Televisão</option>
                        <option value="perifericos">Periféricos</option>
                        <option value="console">Console</option>
                        <option value="impressora">Impressora</option>
                        <option value="outros">Outros</option>
                    </select>
                </div>

                <div class="campo-grupo">
                    <label for="marca">Marca</label>
                    <select id="marca" name="marca" required disabled>
                        <option value="">Selecione primeiro o tipo</option>
                    </select>
                </div>

                <div class="campo-grupo">
                    <label for="modelo">Modelo</label>
                    <select id="modelo" name="modelo" required disabled>
                        <option value="">Selecione primeiro a marca</option>
                    </select>
                    <small id="avisoCatalogo"></small>
                </div>

                <div id="especificacoes" hidden>

                    <div class="campo-grupo" id="campoRam">
                        <label for="ram">Memória RAM</label>
                        <input type="text" id="ram" name="ram"
                               placeholder="Ex.: 8 GB">
                    </div>

                    <div class="campo-grupo" id="campoArmazenamento">
                        <label for="armazenamento">Armazenamento</label>
                        <input type="text" id="armazenamento"
                               name="armazenamento"
                               placeholder="Ex.: 128 GB">
                    </div>

                    <div class="campo-grupo" id="campoTela">
                        <label for="tamanhoTela">Tamanho da tela</label>
                        <input type="text" id="tamanhoTela"
                               name="tamanhoTela"
                               placeholder="Ex.: 6,7 polegadas">
                    </div>

                    <div class="campo-grupo" id="campoProcessador">
                        <label for="processador">Processador</label>
                        <input type="text" id="processador"
                               name="processador"
                               placeholder="Ex.: Intel Core i5">
                    </div>

                </div>

                <div class="campo-grupo">
                    <label for="funcionamento">Estado de funcionamento</label>
                    <select id="funcionamento" name="funcionamento" required>
                        <option value="">Selecione uma opção</option>
                        <option value="funcionando">Funcionando normalmente</option>
                        <option value="parcial">Funcionando parcialmente</option>
                        <option value="defeito">Com defeito</option>
                        <option value="nao_liga">Não liga</option>
                    </select>
                </div>

                <div class="campo-grupo">
                    <label for="descricao">Descrição do eletrônico</label>
                    <textarea id="descricao" name="descricao"
                              rows="5" maxlength="500" required
                              placeholder="Conte um pouco sobre o estado do equipamento..."></textarea>
                </div>

                <div class="campo-grupo">
                    <label for="problema">Problemas ou defeitos (opcional)</label>
                    <textarea id="problema" name="problema"
                              rows="3" maxlength="300"
                              placeholder="Informe se existem danos ou peças com problemas."></textarea>
                </div>

                <div class="campo-grupo">
                    <label for="preco">Preço desejado (R$)</label>
                    <input type="number" id="preco" name="preco"
                           min="0" step="0.01" placeholder="Ex.: 350,00">
                </div>

                <div class="campo-grupo">
                    <label for="foto">Foto do eletrônico</label>
                    <input type="file" id="foto" name="foto"
                           accept="image/jpeg,image/png,image/webp">
                    <small>JPG, PNG ou WEBP. Tamanho máximo: 5 MB.</small>
                </div>

                <button type="submit" class="btn-enviar-eletronico">
                    Enviar eletrônico
                </button>

            </form>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cadastrarEletronico.js"></script>
</body>
</html>
